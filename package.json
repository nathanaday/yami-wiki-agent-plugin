{
  "name": "yami-wiki-agent-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "The wiki tools of Yami Wiki for Claude Code and Codex: point an agent outside your vault at your wiki, and it searches, reads, lints, and ingests with the same tools the vault's agents have.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && vitest run test/unit",
    "check:dist": "node scripts/build.mjs && git diff --exit-code --stat dist",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yami": "https://github.com/nathanaday/yami/releases/download/yami-0.20.0/yami-0.20.0.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
